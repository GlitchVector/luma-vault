    {
      "name": "walks a chain back to the txt2img that started it",
      "why": "five bits per hop puts the root ten bits from the top, out of reach in one step",
      "rows": [
        {
          "id": 1,
          "phash": "00ff00ff0f0f3333",
          "modifiedAt": 1000,
          "img2img": false,
          "grey": 9
        },
        {
          "id": 2,
          "phash": "00ff00ff0f0f332c",
          "modifiedAt": 2000,
          "img2img": true,
          "grey": 9
        },
        {
          "id": 3,
          "phash": "00ff00ff0eff332c",
          "modifiedAt": 3000,
          "img2img": true,
          "grey": 9
        }
      ],
      "start": 3,
      "expect": {
        "id": 1,
        "hops": 2,
        "reachedRoot": true,
        "weakestHop": 5
      }
    },
    {
