# Copy to `.env` — it is gitignored, so it stays on this machine.
#
# This file configures the *scripts* only. `pnpm open-in-forge`,
# `pnpm migrate-prompt` and `pnpm test:forge` load it through Node's own
# `--env-file-if-exists`, so no `.env` is needed for them to run.
#
# The desktop app does not read this file, and cannot: an installed `.app` has
# no repository beside it. Its settings live in the index database instead —
# `forge_url` is the one that matters here. See "Configuration" in the README.

# Where Forge answers.
#
# Set this when the webui runs on another machine — the usual reason being that
# it is the one with the GPU. Note this does *not* move the app's own
# "Open in Forge" button; that reads `forge_url` from the database.
LUMA_FORGE_URL=http://127.0.0.1:7860

# Forge's install directory, for `pnpm setup:forge` to drop the prefill
# extension into. Leave empty to let the installer search the usual places.
LUMA_FORGE_DIR=
