{
  "name": "@luma/comic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "//": "Prose in, lettered comic pages out. Three rerunnable stages plus a QA pass, all behind `pnpm comic`. Only the Forge backend renders; the renderer interface is what a hosted API would implement.",
  "scripts": {
    "comic": "node --env-file-if-exists=../../.env --experimental-strip-types src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luma/core": "workspace:*",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
