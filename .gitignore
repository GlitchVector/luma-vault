node_modules/
dist/
out/
target/
*.tsbuildinfo

# Python virtualenvs — recreated by `pnpm setup:python` / `pnpm setup:upscaler`
venv-classifier/
venv-upscaler/

# Downloaded model weights — fetched by `pnpm setup:python`, never vendored.
models/
__pycache__/
*.pyc

# Runtime data: the SQLite index, generated thumbnails and extracted video
# frames all live under the OS app-data dir, but a dev run can drop them here.
.luma/
apps/desktop/data/
apps/desktop/output-data/

.DS_Store
.env
.env.local

# Tauri generated
apps/desktop/gen/

# Patreon harness. A HAR of a logged-in session IS the session, and
# storageState.json is a live login in a text file. The whole capture directory
# is ignored, not just the raw half: scrubbing makes a HAR safe to share, not
# small — six of them is over 200MB of regenerable evidence. What is worth
# keeping from a capture is endpoints.map.json and the generated file.
packages/patreon-harness/captures/
**/.state.json
